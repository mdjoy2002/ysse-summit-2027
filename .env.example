# Copy this file to .env and replace values as needed.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Vercel automatically sets VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
# Add custom domains above, e.g. ALLOWED_HOSTS=localhost,summit.example.org

# Leave empty to use SQLite locally. For PostgreSQL, use:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DB_CONN_MAX_AGE=600
PRIVATE_MEDIA_ROOT=private_media

# Comma-separated HTTPS origins, e.g. https://summit.example.com
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Send email through the summit Gmail account in development and production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Store a newly generated Google App Password in EMAIL_HOST_PASSWORD locally
# and in deployment secrets; never commit the password.
EMAIL_HOST_USER=imtiazsarderjoy@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=YSSE Summit <imtiazsarderjoy@gmail.com>

# Local development only: simulate checkout without real money or gateway calls.
# Production must use an approved merchant adapter or the fail-closed provider.
PAYMENT_PROVIDER_CLASS=apps.payments.providers.unconfigured.UnconfiguredProvider
PAYMENT_DEMO_ENABLED=False
# Canonical HTTPS origin required by any enabled payment provider, e.g.
# https://summit.example.org. Do not derive provider callback URLs from Host headers.
PUBLIC_BASE_URL=
