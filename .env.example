# Copy this file to .env and replace values as needed.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Leave empty to use SQLite locally. For PostgreSQL, use:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DB_CONN_MAX_AGE=60
PRIVATE_MEDIA_ROOT=private_media

# Comma-separated HTTPS origins, e.g. https://summit.example.com
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Local email is printed to the console. Set SMTP values in deployment secrets
# when real registration notifications should be delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=YSSE Summit <no-reply@example.com>

# Local development only: simulate checkout without real money or gateway calls.
# Production must use an approved merchant adapter or the fail-closed provider.
PAYMENT_PROVIDER_CLASS=apps.payments.providers.demo.DemoProvider
PAYMENT_DEMO_ENABLED=True
# Canonical HTTPS origin required by any enabled payment provider, e.g.
# https://summit.example.org. Do not derive provider callback URLs from Host headers.
PUBLIC_BASE_URL=
